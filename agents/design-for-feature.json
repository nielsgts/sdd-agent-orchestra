{
    "description": "Create design.md from requirements.md for a feature",
    "parameters": {
        "name": {
            "description": "Name of the feature",
            "default": "unnamed"
        }
    },
    "systemPromptFile": "design-for-feature.md",
    "inputPaths": {
        "feature-requirements": {
            "path": "{{ .Config.FeatureDir }}/{{ .Parameters.name }}/requirements.md",
            "description": "The requirements for the new feature",
            "language": "markdown"
        },
        "system-design": {
            "path": "{{ .Config.SpecDir }}/design.md",
            "description": "The latest version of the system design where the new feature has not been added yet",
            "language": "markdown"
        }
    },
    "outputPath": "{{ .Config.FeatureDir }}/{{ .Parameters.name }}/design.md",
    "tools": ["write_result_file", "ask_question", "list_project_dir", "read_project_file"],
    "ruleFiles": [],
    "onNoFunctionCall": "use-tool-to-save.md",
    "model": "default"
}