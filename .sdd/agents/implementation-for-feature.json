{
    "description": "Implement the next Task",
    "parameters": {
        "feature": {
            "description": "Name of the feature",
            "default": "unnamed"
        }
    },
    "systemPromptFile": "implementation-for-feature.md",
    "userPromptFile": "next-task.md",
    "inputPaths": {
        "feature-requirements": {
            "path": "{{ .Config.FeatureDir }}/{{ .Parameters.feature }}/requirements.md",
            "description": "The requirements for the new feature",
            "language": "markdown"
        },
        "system-design": {
            "path": "{{ .Config.SpecDir }}/design.md",
            "description": "The latest version of the system design where the new feature has not been added yet",
            "language": "markdown"
        },
        "feature-design": {
            "path": "{{ .Config.FeatureDir }}/{{ .Parameters.feature }}/design.md",
            "description": "The design for the new feature",
            "language": "markdown"
        },
        "feature-tests": {
            "path": "{{ .Config.FeatureDir }}/{{ .Parameters.feature }}/tests.md",
            "description": "The testing specification for the new feature",
            "language": "markdown"
        }
    },
    "outputPath": "{{ .Config.FeatureDir }}/{{ .Parameters.feature }}/completed_tasks/",
    "outputBackupPath": "",
    "tools": ["complete_task", "ask_question", "list_project_dir", "read_project_file", "write_project_file"],
    "ruleFiles": [],
    "onNoFunctionCall": "use-tool-to-complete.md",
    "model": "default"
}